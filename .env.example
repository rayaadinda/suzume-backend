PORT=8080
ALLOWED_ORIGINS=http://localhost:3000

# Keep this identical to frontend/.env.local BETTER_AUTH_SECRET.
JWT_SECRET=change-this-to-a-long-random-secret

POSTGRES_DB=suzume
POSTGRES_USER=suzume
POSTGRES_PASSWORD=suzume_dev_password
# Used by services inside Docker Compose.
DATABASE_URL=postgres://suzume:suzume_dev_password@postgres:5432/suzume?sslmode=disable